{
  "expo": {
    "name": "FastTrack",
    "slug": "FastTrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.thebrightfusion.fasttrack",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FastTrack uses your photos so you can attach a picture to a meal in your journal. Images stay on your device.",
          "cameraPermission": "FastTrack uses your camera so you can take a photo of a meal for your journal. Images stay on your device.",
          "microphonePermission": false
        }
      ],
      "./plugins/withFastingService.js",
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "95c63cc0-4d35-4068-a644-2a320c42d73b"
      }
    },
    "owner": "thebrightfusion"
  }
}
